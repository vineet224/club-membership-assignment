{
  "info": {
    "name": "FirstClub Membership API",
    "_postman_id": "firstclub-membership-collection",
    "description": "Collection to test FirstClub membership APIs (in-memory). Update {{baseUrl}} if server runs on a different host/port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1" },
    { "key": "planId", "value": "1" },
    { "key": "subscriptionId", "value": "" }
  ],
  "item": [
    {
      "name": "Get Plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/plans",
          "host": ["{{baseUrl}}"],
          "path": ["plans"]
        }
      }
    },
    {
      "name": "Subscribe (create subscription)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"planId\": \"{{planId}}\",\n  \"tier\": \"SILVER\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/subscribe",
          "host": ["{{baseUrl}}"],
          "path": ["subscribe"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  var json = pm.response.json();",
              "  if (json && json.id) { pm.environment.set('subscriptionId', json.id); pm.test('saved subscriptionId', function() { pm.expect(json.id).to.not.be.empty; }); }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Record Purchase (and evaluate tier)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"amount\": 350.0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/purchase",
          "host": ["{{baseUrl}}"],
          "path": ["purchase"]
        }
      }
    },
    {
      "name": "Get Subscriptions for User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscription/user/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["subscription", "user", "{{userId}}"]
        }
      }
    },
    {
      "name": "Get Subscription by Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscription/{{subscriptionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["subscription", "{{subscriptionId}}"]
        }
      }
    },
    {
      "name": "Upgrade Subscription",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscription/{{subscriptionId}}/upgrade",
          "host": ["{{baseUrl}}"],
          "path": ["subscription", "{{subscriptionId}}", "upgrade"]
        }
      }
    },
    {
      "name": "Downgrade Subscription",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscription/{{subscriptionId}}/downgrade",
          "host": ["{{baseUrl}}"],
          "path": ["subscription", "{{subscriptionId}}", "downgrade"]
        }
      }
    },
    {
      "name": "Cancel Subscription",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/subscription/{{subscriptionId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["subscription", "{{subscriptionId}}", "cancel"]
        }
      }
    }
  ]
}
